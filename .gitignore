# Entornos virtuales
venv/
.venv/
env/
ENV/
venv-tts/
venv-photo/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
logs/

# Secretos y configuración local (solo se versionan los *.example)
.env
.env.*
!.env.example
config/*.json
!config/*.example.json

# Salidas generadas (imágenes, etc.)
output/

# Caché de fotogramas extraídos de vídeo (core/frame_cache.py): artefactos, no código.
cache/

# Pesos de los modelos de IA local (Real-ESRGAN/GFPGAN…): se descargan solos.
tools/models/

# Proyectos de vídeo: carpetas autocontenidas con clips y guion de cada trabajo.
# Viven fuera de output/ para que la retención no borre los intermedios, pero
# tampoco se versionan (son artefactos, no código).
projects/

# Artefactos de PyInstaller (ronda 9): nunca se versionan.
build/
dist/
.venv-build/

# Accesos directos de Windows: son binarios con rutas absolutas de la máquina
# (pythonw.exe del venv, C:\Imperator\...), no son portables y cambian con cada
# regeneración. El README explica cómo recrear Imperator.lnk con
# tools/create_shortcut.py; lo versionado es Imperator.bat (texto, portable).
*.lnk

# Medios generados sueltos en la raiz (los de output/ ya estan ignorados)
/*.mp4
/*.png
/*.jpg
/*.jpeg
/*.wav

# Voces de Piper (modelos ONNX descargados, no se versionan)
voices/

# Biblioteca de música de fondo (MP3 del usuario, no se versiona)
music/

# Manual en PDF: artefacto generado por tools/manual_a_pdf.py, no es código.
MANUAL_IMPERATOR.pdf

# Logs sueltos en cualquier carpeta (logs/ ya se ignora; esto cubre *.log sueltos).
*.log

# Cualquier entorno virtual, con cualquier nombre (venv, venv-photo, venv-tts...).
*venv*/
