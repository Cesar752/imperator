# Entornos virtuales
venv/
.venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
logs/

# Secretos y configuración local (solo se versionan los *.example)
.env
.env.*
!.env.example
config/*.json
!config/*.example.json

# Salidas generadas (imágenes, etc.)
output/

# Accesos directos de Windows: son binarios con rutas absolutas de la máquina
# (pythonw.exe del venv, C:\Imperator\...), no son portables y cambian con cada
# regeneración. El README explica cómo recrear Imperator.lnk con
# tools/create_shortcut.py; lo versionado es Imperator.bat (texto, portable).
*.lnk

# Medios generados sueltos en la raiz (los de output/ ya estan ignorados)
/*.mp4
/*.png
/*.jpg
/*.jpeg
/*.wav

# Voces de Piper (modelos ONNX descargados, no se versionan)
voices/

# Biblioteca de música de fondo (MP3 del usuario, no se versiona)
music/
