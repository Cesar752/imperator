# Secretos de la plataforma.
# Este archivo es la PLANTILLA (se versiona). Copia su contenido a ".env"
# (en esta misma carpeta) y rellena las claves. ".env" NO se versiona (.gitignore).

# Black Forest Labs (API de pago). Obten la clave en https://docs.bfl.ai
# (boton "Get API Key"). Se envia en el header "x-key" de la API.
BFL_API_KEY=

# APIs externas de chat (motores "openai" y "deepseek" de engines.json).
# Se leen del entorno con el patrón <ID>_API_KEY; nunca se guardan en el JSON.
# OPENAI_API_KEY la usan TAMBIÉN el motor de visión de pago "openai_vision" y el de
# imagen "openai_image" (la Crónica puede mirar los fotogramas con GPT-4o).
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
